# ============================================================
#  Abhijeet Work Hub - configuration
#  Copy this file to  .env  and edit, OR just set real
#  environment variables. Every value below is OPTIONAL.
#  .env is git-ignored, so this file can stay public.
# ============================================================

# ---------- Appearance ---------------------------------------
# Your name as shown in the app title and sidebar.
OWNER_NAME=Abhijeet
APP_TITLE=Abhijeet Work Hub

# ---------- Where your projects live -------------------------
# Folder that build_catalog.py scans.
# Point this at your own work folder.
#   Windows example:  D:\My Projects
#   Linux / macOS  :  /home/you/projects
# Leave empty to use the bundled ./workspace folder.
WORKSPACE_ROOT=

# ---------- Secrets ------------------------------------------
# Flask session signing key.
# LEAVE THIS EMPTY. When it is empty the app generates a strong
# random key on first run and stores it in data/.secret_key,
# which is git-ignored.
# Generate your own with:
#   python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=

# ---------- Mode ---------------------------------------------
# local  = full power (code browser + rescan + wallet DB)
# public = safe for a server other people can reach.
#          code browser and rescan are switched OFF.
HUB_MODE=local

# ---------- Network ------------------------------------------
HOST=127.0.0.1
PORT=5000